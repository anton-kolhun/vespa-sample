<?xml version="1.0" encoding="UTF-8"?>
<services version="1.0">

    <admin version="2.0">
        <configservers>
            <configserver hostalias="vespa-0"/>
            <configserver hostalias="vespa-1"/>
            <configserver hostalias="vespa-2"/>
        </configservers>
        <logserver hostalias="vespa-0"/>
    </admin>

    <container id="container" version="1.0">
        <search/>
        <document-api/>
        <document-processing/>
        <nodes>
            <node hostalias="vespa-0"/>
            <node hostalias="vespa-1"/>
            <node hostalias="vespa-2"/>
        </nodes>
    </container>

    <container id="backup" version="1.0">
        <document-processing/>
        <nodes>
            <node hostalias="vespa-backup"/>
        </nodes>
    </container>

    <content id="content" version="1.0">
        <redundancy>2</redundancy>
        <documents>
            <document type="item" mode="index"/>
            <document-processing cluster="container"/>
        </documents>
        <tuning>
            <resource-limits>
                <disk>0.95</disk>
            </resource-limits>
        </tuning>
        <nodes>
            <node distribution-key="0" hostalias="vespa-0"/>
            <node distribution-key="1" hostalias="vespa-1"/>
            <node distribution-key="2" hostalias="vespa-2"/>
        </nodes>
    </content>

</services>
